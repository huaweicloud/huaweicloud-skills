      "type": "MULTICYCLE",
      "enabled": true,
      "region": "cn-east-2",
      "policies": [
        {
          "metric_name": "eip_metric1",
          "dimension_name": "publicip_id",
          "period": 300,
          "filter": "average",
          "comparison_operator": ">=",
          "value": 100,
          "unit": "Mbit/s",
          "level": 2
        }
      ],
      "resources": [],
      "notification_enabled": true,
      "alarm_notifications": [
        {"notification_list": ["urn:smn:cn-east-2:project_id:topic-004"]}
      ]
    }
  ]
}
