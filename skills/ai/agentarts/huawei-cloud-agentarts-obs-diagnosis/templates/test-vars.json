{
  "_description": "Test case templates with placeholder endpoints. All {VARIABLES} are resolved at runtime.",
  "test_cases": [
    {
      "id": "TC-01",
      "name": "List APM businesses",
      "command": "hcloud APM ListBusiness --cli-region=cn-north-4",
      "expected": "List of APM businesses returned",
      "type": "cli",
      "feature_point": "FP-01"
    },
    {
      "id": "TC-02",
      "name": "Show APM business detail",
      "command": "hcloud APM ShowBusinessDetail --cli-region=cn-north-4 --business_id={business_id}",
      "expected": "Business detail returned",
      "type": "cli",
      "feature_point": "FP-01"
    },
    {
      "id": "TC-03",
      "name": "Show APM business token",
      "command": "hcloud APM ShowToken --cli-region=cn-north-4 --x-business-id={business_id}",
      "expected": "Business token returned",
      "type": "cli",
      "feature_point": "FP-01"
    },
    {
      "id": "TC-04",
      "name": "Show APM access point",
      "command": "hcloud APM ShowAccessPoint --cli-region=cn-north-4 --x-business-id={business_id}",
      "expected": "Access point info returned",
      "type": "cli",
      "feature_point": "FP-01"
    },
    {
      "id": "TC-05",
      "name": "Search APM agents",
      "command": "hcloud APM SearchAgent --cli-region=cn-north-4 --x-business-id={business_id}",
      "expected": "Agent list returned (empty if no agents)",
      "type": "cli",
      "feature_point": "FP-03"
    },
    {
      "id": "TC-06",
      "name": "Search APM transactions (traces)",
      "command": "hcloud APM SearchTransaction --cli-region=cn-north-4 --x-business-id={business_id} --start_time=1720000000000 --end_time=1720600000000",
      "expected": "Transaction list returned (empty if no traces)",
      "type": "cli",
      "feature_point": "FP-03"
    },
    {
      "id": "TC-07",
      "name": "List AOM Prometheus instances",
      "command": "hcloud AOM ListPromInstance --cli-region=cn-north-4 --Enterprise-Project-Id=0",
      "expected": "List of Prometheus instances returned",
      "type": "cli",
      "feature_point": "FP-02"
    },
    {
      "id": "TC-08",
      "name": "List AOM access codes",
      "command": "hcloud AOM ListAccessCode --cli-region=cn-north-4",
      "expected": "List of access codes returned",
      "type": "cli",
      "feature_point": "FP-02"
    },
    {
      "id": "TC-09",
      "name": "AOM Prometheus instant query",
      "command": "hcloud AOM ListInstantQueryAomPromGet --cli-region=cn-north-4 --query=up --prom_instance_id={prom_id}",
      "expected": "Prometheus query result returned",
      "type": "cli",
      "feature_point": "FP-02"
    },
    {
      "id": "TC-10",
      "name": "AOM Prometheus metadata",
      "command": "hcloud AOM ListMetadataAomPromGet --cli-region=cn-north-4 --prom_instance_id={prom_id}",
      "expected": "Prometheus metadata returned",
      "type": "cli",
      "feature_point": "FP-02"
    },
    {
      "id": "TC-11",
      "name": "List LTS log groups",
      "command": "hcloud LTS ListLogGroups --cli-region=cn-north-4",
      "expected": "List of log groups returned",
      "type": "cli",
      "feature_point": "FP-04"
    },
    {
      "id": "TC-12",
      "name": "List LTS log streams",
      "command": "hcloud LTS ListLogStreams --cli-region=cn-north-4 --log_group_id={group_id}",
      "expected": "List of log streams returned",
      "type": "cli",
      "feature_point": "FP-04"
    },
    {
      "id": "TC-13",
      "name": "List LTS logs",
      "command": "hcloud LTS ListLogs --cli-region=cn-north-4 --log_group_id={group_id} --log_stream_id={stream_id} --start_time=1720000000000 --end_time=1720600000000",
      "expected": "Log entries returned (empty if no logs)",
      "type": "cli",
      "feature_point": "FP-04"
    },
    {
      "id": "TC-14",
      "name": "List IAM policies",
      "command": "hcloud IAM ListPoliciesV5 --cli-region=cn-north-4",
      "expected": "List of IAM policies returned",
      "type": "cli",
      "feature_point": "FP-05"
    },
    {
      "id": "TC-15",
      "name": "Get IAM authorization schema for APM",
      "command": "hcloud IAM GetAuthorizationSchemaV5 --cli-region=cn-north-4 --service_code=apm",
      "expected": "Authorization schema for APM returned",
      "type": "cli",
      "feature_point": "FP-05"
    },
    {
      "id": "TC-16",
      "name": "List APM open regions",
      "command": "hcloud APM ListOpenRegion --cli-region=cn-north-4",
      "expected": "List of open regions returned",
      "type": "cli",
      "feature_point": "FP-01"
    }
  ],
  "variables": {
    "business_id": "<your-business-id>",
    "prom_id": "<your-prometheus-instance-id>",
    "group_id": "<your-log-group-id>",
    "stream_id": "<your-log-stream-id>"
  }
}
