# Auto-generated by cloudrobo custom-operator skill
# Generated during Phase 1 (Code Adaptation) based on operator_config.yaml
#
# Layer ordering is optimized for Docker build cache AND image size:
#   1. Base image + system packages (rarely changes)
#   2. requirements.txt + pip install (changes only when deps change)
#   3. Source code (changes frequently — isolated from deps layer)
#   4. entrypoint.py (changes only when skill updates)
#
# Image slimming rules (see references/custom-operator/custom-operator-reference.md §Image Slimming):
#   - install system packages AND clean their caches in the SAME RUN layer
#   - pip install with --no-cache-dir, then remove ~/.cache/pip in the same RUN
#   - prefer multi-stage builds when gcc/headers are needed only at build time
#   - pin the base image tag (never :latest)

# Base image is resolved from operator_config.yaml image.base — the build
# environment must be able to pull it (use a reachable registry on your network).
FROM {{ image_base }}

WORKDIR /app

# ── Layer 1: System packages (if configured) ─────────────────────────
# Uncomment and modify if operator_config.yaml dependencies.system_packages is set.
# IMPORTANT: clean package-manager caches in the SAME RUN to avoid bloating the image.
#   apt-based (Debian/Ubuntu):
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     libgl1-mesa-glx \
#     libglib2.0-0 \
#     && rm -rf /var/lib/apt/lists/*
#   dnf/yum-based (HCE/EulerOS):
# RUN dnf install -y gcc gcc-c++ make \
#     && dnf clean all \
#     && rm -rf /var/cache/dnf
# NOTE (HCE): to build C-extension deps (e.g. evdev via pynput) you ALSO need
#   binutils-extra (HCE binutils ships WITHOUT ld), kernel-headers, python3-devel:
# RUN dnf install -y binutils binutils-extra gcc make kernel-headers python3-devel \
#     && dnf clean all && rm -rf /var/cache/dnf
#   and remove them afterwards to slim the image (see references/custom-operator/custom-operator-reference.md
#   §Verified production lessons, lesson 5).
# NOTE (network): `docker build` RUN steps do NOT inherit the daemon proxy — pass
#   --build-arg HTTP_PROXY/HTTPS_PROXY/NO_PROXY (see references/custom-operator/custom-operator-reference.md
#   §Verified production lessons, lesson 4).

# ── Layer 2: Python dependencies (cached if requirements.txt unchanged) ──
# IMPORTANT: Copy requirements.txt BEFORE src/ for layer caching.
# If requirements.txt hasn't changed, this layer is reused on rebuild,
# skipping the pip install step entirely.
# NOTE: Some base images (e.g. HCE Python registry-cbu.huawei.com/cloudrobo/
# hce-python:* or plain hce-python) ship WITHOUT pip. For pure-stdlib operators
# (empty requirements.txt) tolerate the failure instead of breaking the build.
# NOTE (CPU-only operators): prefer `opencv-python-headless` over `opencv-python`
# (no X11 libs needed) and install CPU torch via
#   --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple
# (see references/custom-operator/custom-operator-reference.md §Verified production lessons, lessons 6–7).
COPY requirements.txt .
RUN python3 -m pip install --no-cache-dir -r requirements.txt 2>/dev/null \
    && rm -rf ~/.cache/pip \
    || echo "pip not available in base image, continuing with stdlib only"

# ── Layer 3: User source code ────────────────────────────────────────
COPY ./src ./src

# ── Layer 4: Generated entrypoint ────────────────────────────────────
COPY entrypoint.py .

# ── Runtime configuration ────────────────────────────────────────────
# SOURCE_DATASET_PATH is injected by the platform at task execution time.
# The value here is a fallback; the platform overrides it.
ENV SOURCE_DATASET_PATH={{ source_dataset_path_fallback }}

# Entrypoint runs the generated entrypoint.py which:
#   1. Reads SOURCE_DATASET_PATH env var
#   2. Derives INPUT_DIR and OUTPUT_DIR
#   3. Imports user's process() function from src/
#   4. Iterates input items and writes outputs
# python3 (not python): some base images only provide python3.
ENTRYPOINT ["python3", "/app/entrypoint.py"]
