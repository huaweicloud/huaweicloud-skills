    {
      "id": "TC-27",
      "name": "delete-members-sdk",
      "executor": "sdk",
      "command": "client.delete_workspace_members('${WORKSPACE_ID}', ['${USER_ID}'])",
      "expected": "Empty response (members deleted)",
      "type": "mutation",
      "requires": "WORKSPACE_ID, USER_ID",
      "requires_confirmation": true,
      "status": "pending"
    },
    {
      "id": "TC-28",
      "name": "onboarding-flow",
      "executor": "cli",
      "command": "workspace list → workspace create → workspace use → workspace current",
      "expected": "Full onboarding: list existing → create new → switch context → verify",
      "type": "mutation",
      "requires_confirmation": true,
      "status": "pending"
    }
  ],
  "environment_variables": {
    "required": ["HUAWEI_CLOUD_AK", "HUAWEI_CLOUD_SK"],
    "optional": ["WORKSPACE_ID", "USER_ID", "ROLE_ID", "CLOUDROBO_DEBUG"]
  },
  "notes": [
    "Read-only tests (TC-01 to TC-10, TC-19 to TC-22) run automatically.",
    "Mutation tests (TC-11 to TC-18, TC-23 to TC-28) require explicit user confirmation.",
    "Set WORKSPACE_ID to run workspace-specific tests (TC-03, TC-07 to TC-10, TC-13 to TC-18, TC-20, TC-22, TC-24 to TC-27).",
    "Set USER_ID and ROLE_ID to run member management tests (TC-12, TC-15 to TC-17, TC-26, TC-27).",
    "TC-28 (onboarding-flow) is an end-to-end test combining list, create, use, and current."
  ]
}
