      "type": "mutation",
      "requires": "WORKSPACE_ID",
      "requires_confirmation": true,
      "status": "pending"
    },
    {
      "id": "TC-26",
      "name": "add-members-sdk",
      "executor": "sdk",
      "command": "client.add_workspace_members('${WORKSPACE_ID}', {'member_list': [{'user_id': '${USER_ID}', 'role_ids': ['${ROLE_ID}']}]})",
      "expected": "Dict with added members",
      "type": "mutation",
      "requires": "WORKSPACE_ID, USER_ID, ROLE_ID",
