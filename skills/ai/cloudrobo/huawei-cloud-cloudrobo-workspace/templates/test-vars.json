      "type": "read",
      "requires": "WORKSPACE_ID",
      "status": "pending"
    },
    {
      "id": "TC-23",
      "name": "create-workspace-sdk",
      "executor": "sdk",
      "command": "client.create_workspace({'name': 'sdk-test', 'default_obs_path': 'obs://bucket/test'})",
      "expected": "Dict with workspace_id and asset_catalog_id",
      "type": "mutation",
      "requires_confirmation": true,
      "status": "pending"
    },
    {
      "id": "TC-24",
      "name": "update-workspace-sdk",
