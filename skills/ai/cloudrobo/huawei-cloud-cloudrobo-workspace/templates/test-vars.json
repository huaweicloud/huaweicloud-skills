      "type": "mutation",
      "requires": "WORKSPACE_ID",
      "requires_confirmation": true,
      "status": "pending"
    },
    {
      "id": "TC-25",
      "name": "delete-workspace-sdk",
      "executor": "sdk",
      "command": "client.delete_workspace('${WORKSPACE_ID}')",
