        "params": {"inputs": [{"name": "ROBOT_CONFIG_PATH", "url_path": "obs://<bucket>/robot/"}]}},
       {"id": "diversity-eval", "name": "多样性评测", "operator": "数据集多样性评测-LeRobot"}
     ]}
  ]
