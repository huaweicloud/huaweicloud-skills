      "type": "query",
      "executor": "cli",
      "command": "hcloud CodeArtsPipeline ListPipelines --cli-region={region} --project_id={project_id} --offset=0 --limit=10",
      "note": "Test account IAM project may not be a CodeArts (DevCloud) project; pipeline.00060101 项目不存在 is the EXPECTED outcome proving CLI+auth wiring, not a skill defect."
    },
    {
