region_name = "cn-north-4"

security_group_rules = [
  {
    direction        = "ingress"
    description      = "Allow SSH access"
    ethertype        = "IPv4"
    protocol         = "tcp"
    ports            = "22"
    remote_ip_prefix = "203.0.113.10/32" # Replace with your approved source CIDR.
  },
  {
    direction        = "ingress"
    description      = "Allow HTTP and HTTPS access"
    ethertype        = "IPv4"
    protocol         = "tcp"
    ports            = "80,443"
    remote_ip_prefix = "203.0.113.10/32"
  },
  {
    direction        = "ingress"
    description      = "Allow ICMP access"
    ethertype        = "IPv4"
    protocol         = "icmp"
    ports            = null
    remote_ip_prefix = "203.0.113.10/32"
  }
]

# Required secret input: provide TF_VAR_ecs_admin_password at runtime; never store it in this file.

# VPC configurations
vpcs = [
  {
    vpc_name          = "demo-vpc-one"
    vpc_cidr          = "192.168.0.0/16"
    subnet_name       = "demo-subnet-one"
    subnet_cidr       = "192.168.1.0/24"
    subnet_gateway_ip = "192.168.1.1"
    instance_name     = "demo-instance-one"
  },
  {
    vpc_name          = "demo-vpc-other"
    vpc_cidr          = "10.0.0.0/16"
    subnet_name       = "demo-subnet-other"
    subnet_cidr       = "10.0.2.0/24"
    subnet_gateway_ip = "10.0.2.1"
    instance_name     = "demo-instance-other"
  }
]

# NAT Gateway configuration
nat_gateway_name = "demo-nat-gateway"
bandwidth_size   = 10
