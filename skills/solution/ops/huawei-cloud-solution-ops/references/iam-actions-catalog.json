{
  "schema_version": 1,
  "description": "Best-effort IAM action hints for hcloud permission troubleshooting. Verify the exact policy syntax against Huawei Cloud IAM documentation and tenant-side custom policies before requesting changes.",
  "matching_notes": [
    "Use operation-level entries first.",
    "If an operation is not listed, use service default_readonly_actions or default_change_actions only as a starting point.",
    "Enterprise project, region/project scope, service enablement, agency trust, SCP, and custom deny policies can still block a request even when the action appears allowed."
  ],
  "services": {
    "BSS": {
      "permission_scope": "global-account",
      "default_readonly_actions": [
        "bss:bill:view",
        "bss:cost:view"
      ],
      "operations": {
        "ShowCustomerMonthlySum": {
          "risk": "readonly",
          "required_actions": [
            "bss:bill:view"
          ],
          "notes": "Monthly bill summary. Use BSS region cn-north-1; this operation does not accept X-Language, and cli-lang is only a KooCLI profile setting."
        },
        "ListCosts": {
          "risk": "readonly",
          "required_actions": [
            "bss:cost:view"
          ],
          "notes": "Cost analysis read. Confirm account scope, time range, and enterprise project scope before live execution."
        },
        "ListCustomerBillsMonthlyBreakDown": {
          "risk": "readonly",
          "required_actions": [
            "bss:bill:view"
          ],
          "notes": "Bill breakdown can expose sensitive cost identifiers; summarize results before display."
        },
        "ListResourceRecords": {
          "risk": "readonly",
          "required_actions": [
            "bss:bill:view"
          ],
          "notes": "Resource-level bill records can expose resource identifiers; use protected-identifier redaction."
        }
      }
    },
