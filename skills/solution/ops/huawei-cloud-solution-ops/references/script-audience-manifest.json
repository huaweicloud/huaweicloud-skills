  "user_profile_notes": {
    "beginner": [
      "Start with hcloud_environment_doctor.py and hcloud_context_inspect.py.",
      "Explain optional tools by task instead of requiring hcloud, SDK, Terraform, and obsutil all at once."
    ],
    "small_business": [
      "Prefer low-cost static-site and Flexus/ECS routing before broad enterprise architecture.",
      "Expose billing readonly and idle candidate review without delete commands."
    ],
    "mid_enterprise": [
      "Use inventory, governance closure, observability, and Terraform plan-review assets.",
      "Keep batch mutation and Terraform apply out of the default path until evidence and approvals are explicit."
    ]
  }
