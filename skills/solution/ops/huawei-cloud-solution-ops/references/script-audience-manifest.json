  "consolidation_policy": {
    "current_action": "Keep existing script files stable, declare public contracts explicitly, and migrate high-value entry points through shared helpers.",
    "do_not_do": [
      "Do not merge runtime scripts just to reduce file count.",
      "Do not remove compatibility entry points that existing workflows may call.",
      "Do not broaden planner-only scripts into submit paths.",
      "Do not add ungated Terraform import, drift automation, remote state, or blueprint execution to the default path."
    ],
    "future_candidates": [
      {
        "area": "acceptance closure",
        "candidate": "Prefer hcloud_acceptance_closure.py as the user-facing plan/run/evaluate wrapper while preserving probe plan, probe run, and evidence result modules for compatibility and focused tests."
      },
      {
        "area": "closure planning",
        "candidate": "Prefer hcloud_closure_plan.py as the user-facing lifecycle/governance/scenario wrapper while preserving tier-specific planners for compatibility and focused tests."
      },
      {
        "area": "catalog maintenance",
        "candidate": "Wrap build, diff, audit, and smoke utilities behind one maintenance command while preserving current modules."
      },
      {
        "area": "Terraform",
        "candidate": "Keep import/drift/remote-state behind explicit state-change gates and evidence-based post-change readback, preferring hcloud while allowing equivalent SDK/API, data-source, or business-probe evidence."
      },
      {
        "area": "MaaS API helpers",
        "candidate": "Keep qwen_text_to_image.py as a compatibility shim while new model, chat, image, and video helpers use MaaS-named entry points."
      },
      {
        "area": "Billing",
        "candidate": "Keep probe, readonly planner, and result summarizer separate because they have different data-sensitivity boundaries."
      }
    ],
    "compatibility_retirement_policy": {
      "v0_8": "Mark compatibility entry points deprecated and keep new docs/routes/examples on unified entry points.",
      "v0_9": "Move primary tests to unified entry points; keep only lightweight smoke coverage for compatibility names.",
      "v1_0": "Remove or internalize compatibility entry points that have no dedicated user-facing need across two minor releases.",
      "source": "references/versioning-policy.md"
    }
  },
  "hcloud_execution_boundary": {
    "business_api_policy": "safe_exec_by_default_with_evidenced_fallback",
    "agent_fallback_boundary": "Prefer hcloud_safe_exec for normal business API reads and changes. Direct hcloud remains available when metadata/help evidence confirms the exact service, operation version, parameters, output size, risk, and verification evidence; scripts are shortcuts rather than an operation whitelist.",
    "purpose": "Make the shared execution boundary reviewable without creating a service, operation, parameter, or call-order whitelist for the Agent.",
    "direct_invocation_categories": [
      {
        "id": "safe_business_api_executor",
        "boundary": "The single bundled executor that may launch resolved hcloud business API and OBS argv after shared redaction, output, timeout, version, and risk handling.",
        "allowed_command_shapes": [
          "resolved <service> <operation/version> argv",
          "hcloud obs argv"
        ],
        "scripts": [
          "scripts/hcloud_safe_exec.py"
        ]
      },
      {
        "id": "metadata_and_diagnostics",
        "boundary": "Code-owned direct hcloud calls are limited to non-resource metadata, help, version, and cache bootstrap. They do not submit or read a tenant business resource API.",
        "allowed_command_shapes": [
          "version",
          "<service> --help",
          "<service> <operation> --help",
          "meta download"
        ],
        "scripts": [
          "scripts/hcloud_context_inspect.py",
          "scripts/hcloud_environment_doctor.py",
          "scripts/hcloud_meta_lookup.py",
          "scripts/hcloud_operation_resolver.py",
          "scripts/hcloud_prewarm_cache.py",
          "scripts/hcloud_terraform_context_inspect.py"
        ]
      }
    ]
  },
