#!/usr/bin/env python3
"""Run one bundled huaweicloud-skill script from any working directory."""

from __future__ import annotations

import os
import re
import shutil
import sys
from pathlib import Path

SCRIPT_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
USAGE = "Usage: hcloud-skill <script-name[.py]> [script arguments...]"


def fail(message: str, return_code: int = 2) -> int:
    """Print one launcher error and return its process exit code."""
    print(f"hcloud-skill: {message}", file=sys.stderr)
    return return_code


def resolve_script(raw_name: str, skill_root: Path) -> Path | None:
    """Resolve a basename-only public script beneath the installed Skill root."""
    if not SCRIPT_NAME.fullmatch(raw_name):
        return None
    script_name = raw_name if raw_name.endswith(".py") else f"{raw_name}.py"
    script_path = skill_root / "scripts" / script_name
    return script_path if script_path.is_file() else None


def resolve_python() -> str | None:
    """Resolve the interpreter used for the bundled child script."""
    requested = os.environ.get("HUAWEICLOUD_SKILL_PYTHON") or sys.executable
    return shutil.which(requested)


def main(argv: list[str] | None = None) -> int:
    """Validate the script name, then replace this process with that script."""
    arguments = list(sys.argv[1:] if argv is None else argv)
    if not arguments:
        print(USAGE, file=sys.stderr)
        return 2
    if arguments[0] in {"-h", "--help"}:
        print(USAGE)
        print("The script name is resolved only from this Skill's scripts directory.")
        return 0

    skill_root = Path(__file__).resolve().parents[1]
    script_path = resolve_script(arguments[0], skill_root)
    if script_path is None:
        return fail(f"unknown or invalid bundled script name: {arguments[0]!r}")

    python = resolve_python()
    if python is None:
        return fail(
            "Python is unavailable; install Python 3.12+ or set HUAWEICLOUD_SKILL_PYTHON.",
            return_code=127,
        )

    try:
        os.execv(python, [python, str(script_path), *arguments[1:]])
    except OSError as exc:
        return fail(f"could not start {script_path.name}: {exc}", return_code=126)
    return 126


if __name__ == "__main__":
    raise SystemExit(main())
