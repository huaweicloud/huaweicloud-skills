#!/usr/bin/env bash
# ============================================================
# 公网迁移环境变量模板 (public)
# 用法: 先按需替换 <...> 占位符，然后 source 本文件：
#   cp env.public.sh.example env.public.sh
#   vim env.public.sh            # 填入真实值
#   source env.public.sh         # 注入当前 shell
#   python3 preflight_check.py --scenario public   # 验证
# ============================================================

# ---- 云侧凭证（必设）----
export migration_Access_Key="<ak>"
export migration_Secret_Access_Key="<sk>"
export migration_password="<windows-admin密码>"
export migration_domain="<云账号domain>"

# ---- 主机信息（公网：只含源端对象，use_public_ip="true"）----
export Host_Information='[
  {
    "主机名": "win-src-1",
    "公网IP": "<源端公网IP>",
    "内网IP": "<源端内网IP>",
    "端口号": "5985",
    "用户名": "Administrator",
    "密码": "<源端密码>",
    "region_id": "cn-north-4",
    "region_name": "华北-北京四",
    "project_id": "<project_id, 可留空>",
    "project_name": "<project_name, 可留空>",
    "os_type": "WINDOWS",
    "use_public_ip": "true"
  }
]'

echo "[public] 环境变量已注入。运行检查: python3 preflight_check.py --scenario public"