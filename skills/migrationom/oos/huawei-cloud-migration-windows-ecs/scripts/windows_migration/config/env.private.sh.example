#!/usr/bin/env bash
# ============================================================
# 私网迁移环境变量模板 (private)
# 用法: 先按需替换 <...> 占位符，然后 source 本文件：
#   cp env.private.sh.example env.private.sh
#   vim env.private.sh            # 填入真实值
#   source env.private.sh         # 注入当前 shell
#   python3 preflight_check.py --scenario private   # 验证
# ============================================================

# ---- 云侧凭证（必设）----
export migration_Access_Key="<ak>"
export migration_Secret_Access_Key="<sk>"
export migration_password="<windows-admin密码>"
export migration_domain="<云账号domain>"

# ---- 主机信息（私网：源端对象 + 代理对象）----
export Host_Information='[
  {
    "主机名": "win-src-1",
    "公网IP": "<源端公网IP>",
    "内网IP": "<源端内网IP>",
    "端口号": "5985",
    "用户名": "Administrator",
    "密码": "<源端密码>",
    "region_id": "cn-north-4",
    "region_name": "华北-北京四",
    "project_id": "<project_id, 可留空>",
    "project_name": "<project_name, 可留空>",
    "os_type": "WINDOWS",
    "use_public_ip": "false"
  },
  {
    "代理主机名": "jump-1",
    "公网IP": "<跳板机公网IP>",
    "内网IP": "<跳板机内网IP>",
    "端口号": "22",
    "用户名": "root",
    "密码": "<跳板机密码>",
    "region_id": "cn-north-4",
    "region_name": "华北-北京四"
  }
]'

echo "[private] 环境变量已注入。运行检查: python3 preflight_check.py --scenario private"